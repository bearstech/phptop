#!/usr/bin/make -f

configure: 
				dh_testdir
build: configure 
				dh_testdir
				touch $@

clean: 
				dh_testdir
				dh_testroot
				dh_clean 

install: build
				dh_testdir
				dh_testroot
				dh_prep
				dh_installdirs
				dh_install

binary: build install
				dh_testdir
				dh_testroot
				dh_installchangelogs 
				dh_installdocs
				dh_installexamples
				dh_installman
				dh_link
				dh_compress
				dh_fixperms
				dh_installdeb
				dh_gencontrol
				dh_md5sums
				dh_builddeb

binary-arch:
binary-indep:

.PHONY: build clean binary install configure
